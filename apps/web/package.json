{
  "name": "inside-coding-agents-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "sync:content": "node scripts/sync-content.mjs",
    "predev": "npm run sync:content",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run sync:content",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "npm run sync:content && DEPLOY_TARGET=github-pages NEXT_PUBLIC_BASE_PATH=/inside-coding-agents NEXT_PUBLIC_SITE_URL=https://vpromise.github.io/inside-coding-agents NEXT_TELEMETRY_DISABLED=1 next build",
    "audit:ci": "node scripts/check-audit.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler dev --config dist/server/wrangler.json --local",
    "test": "npm run build && node --test tests/audit-policy.test.mjs tests/toolchain-compat.test.mjs tests/rendered-html.test.mjs",
    "test:pages": "npm run build:pages && node --test tests/static-export.test.mjs",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "test:lighthouse": "lhci autorun",
    "test:quality": "npm run test:browser && npm run test:lighthouse",
    "prelint": "npm run sync:content",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "npm run sync:content && tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.67.0",
    "@eslint/js": "9.39.4",
    "@lhci/cli": "0.16.0",
    "@next/eslint-plugin-next": "16.4.4",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.37",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "minimatch": "11.0.4",
    "next": "16.4.4",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vinext": "1.4.2",
    "vite": "8.3.5",
    "wrangler": "4.156.2"
  },
  "overrides": {
    "@lhci/cli": {
      "chrome-launcher": "1.2.2"
    },
    "basic-ftp": "6.2.5",
    "fflate": "0.7.5",
    "glob": "14.0.3",
    "minimatch": "$minimatch",
    "tmp": "0.2.7"
  },
  "type": "module"
}
