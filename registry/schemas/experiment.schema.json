{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inside-coding-agents:schema:experiment:0.1.0",
  "title": "Inside Coding Agents Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "question",
    "mode",
    "status",
    "fixture",
    "scenario",
    "subjects",
    "repetitions",
    "metrics",
    "success_criteria",
    "limitations",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "$ref": "#/$defs/stableId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string"
    },
    "mode": {
      "enum": ["native", "controlled", "adversarial"]
    },
    "status": {
      "enum": ["draft", "ready", "running", "complete", "blocked", "superseded"]
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revision", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "prompt_sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "snapshot_id",
          "surface",
          "model",
          "comparison_status"
        ],
        "properties": {
          "agent_id": {
            "$ref": "#/$defs/stableId"
          },
          "snapshot_id": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string"
          },
          "comparison_status": {
            "enum": ["comparable", "partially-comparable", "not-comparable"]
          },
          "configuration": {
            "type": "object"
          },
          "uncontrolled_variables": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traces_path", "results_path"],
      "properties": {
        "traces_path": {
          "type": "string",
          "minLength": 1
        },
        "results_path": {
          "type": "string",
          "minLength": 1
        },
        "report_path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
