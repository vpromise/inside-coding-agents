{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inside-coding-agents:schema:curriculum-catalog:0.1.0",
  "title": "Inside Coding Agents Curriculum Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "track", "title", "lessons"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "track": {"$ref": "#/$defs/stableId"},
    "title": {"$ref": "#/$defs/localizedText"},
    "lessons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lesson"}}
  },
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh-CN", "en"],
      "properties": {
        "zh-CN": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    },
    "contentPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh-CN", "en"],
      "properties": {
        "zh-CN": {"type": "string", "pattern": "^curriculum/.+\\.zh\\.md$"},
        "en": {"type": "string", "pattern": "^curriculum/.+\\.en\\.md$"}
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "slug", "title", "summary", "mechanism_ids", "status", "content_paths", "run"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "number": {"type": "string", "pattern": "^[0-9]{2}$"},
        "slug": {"$ref": "#/$defs/stableId"},
        "title": {"$ref": "#/$defs/localizedText"},
        "summary": {"$ref": "#/$defs/localizedText"},
        "mechanism_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
        "status": {"enum": ["planned", "implemented", "verified"]},
        "content_paths": {"$ref": "#/$defs/contentPaths"},
        "run": {"type": "string", "minLength": 1}
      }
    }
  }
}
